import 'package:get/get.dart';

extension {prefix}ParamsForGetExt on String {
  dynamic get argValue => Get.arguments?[this];

  set argValue(value) => Get.arguments?[this] = value;

  String? get paramValue => Get.parameters[this];

  set paramValue(value) => Get.parameters[this] = value;
}

class {prefix}Params {
{params}
}
